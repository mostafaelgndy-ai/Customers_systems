# =============================================================
# CustomerIQ example environment file
# Copy to `.env` and adjust. Never commit real credentials.
# =============================================================

# --- Application ---
ENVIRONMENT=dev                     # dev | staging | prod
SECRET_KEY=change-me-generate-a-long-random-string

# --- Database (PostgreSQL in Docker; SQLite only for quick local experimentation) ---
POSTGRES_USER=customeriq
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=customeriq
DATABASE_URL=postgresql+psycopg://customeriq:change-me-strong-password@localhost:5432/customeriq

# --- Cache / broker ---
REDIS_URL=redis://localhost:6379/0

# --- Background jobs ---
# true  = execute jobs synchronously in-process (development/tests only)
# false = dispatch to Celery workers
INLINE_JOBS=true

# --- Uploads ---
UPLOAD_DIR=data/uploads            # resolved relative to the backend process
MAX_UPLOAD_MB=50

# --- Trained model artifacts (CHURN-12) ---
MODELS_DIR=data/models

# --- CSV export files (API-10/JOB-06) ---
EXPORTS_DIR=data/exports

# --- Rate limiting (SEC-04). Disabled by default; enable per deployment ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_EXPENSIVE_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- Risk bands (CHURN-14): configuration, not hardcoded business truth ---
RISK_BAND_LOW_MAX=0.30
RISK_BAND_HIGH_MIN=0.70

# --- Auth ---
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=7

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
